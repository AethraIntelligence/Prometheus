# Provider access and paths. Nothing else belongs here.
#
# The switches below - flags, approvals, timeouts, limits - can also be changed
# in the window, Settings -> General. What is saved there goes to
# $PROMETHEUS_DATA_DIR/settings.json and wins over this file; a variable exported
# in the shell wins over both (ADR 0023).

# API key for the LLM provider (Phase 2).
PROMETHEUS_LLM_API_KEY=

# Provider endpoint. Which models exist and what they cost lives in the model
# catalog, not here - see infrastructure/llm/models.toml.
PROMETHEUS_LLM_BASE_URL=https://openrouter.ai/api/v1
PROMETHEUS_LLM_DEFAULT_MODEL=anthropic/claude-sonnet-5

# Point at your own catalog to override the bundled one. The bundled local
# catalog runs everything against a model on this machine, with no key and no
# cost - useful for development and for validating a phase.
# PROMETHEUS_MODEL_CATALOG_PATH=infrastructure/llm/models.local.toml

# Where a locally served model listens (Ollama's default shown).
PROMETHEUS_LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1

# How many times to retry a transient provider error.
PROMETHEUS_LLM_RETRY_ATTEMPTS=3

# How long to wait on a model. Left unset, each provider uses its own default -
# two minutes for a hosted one, ten for a model running on this machine, because
# a slow local answer is usually still coming. Set it to override both.
# PROMETHEUS_LLM_TIMEOUT_SECONDS=300

# Where the SQLite file and any local artifacts live.
PROMETHEUS_DATA_DIR=~/.prometheus

# Logging.
PROMETHEUS_LOG_LEVEL=INFO
PROMETHEUS_LOG_FORMAT=json

# Language the agents answer in. Never hard-code a language in the sources.
PROMETHEUS_RESPONSE_LANGUAGE=en

# --- The local interface (prometheus serve) -----------------------------------------

# Loopback, deliberately. This surface starts tasks and approves irreversible
# actions, and it has no authentication because nothing off this machine can
# reach it - binding it elsewhere makes a local tool an unauthenticated remote
# one.
PROMETHEUS_UI_HOST=127.0.0.1
PROMETHEUS_UI_PORT=8765

# How long an irreversible action waits for someone to answer in the interface
# before it is refused. A forgotten browser tab must not park a task all day.
PROMETHEUS_UI_APPROVAL_TIMEOUT_SECONDS=600

# How many past tasks the history list loads.
PROMETHEUS_UI_HISTORY_LIMIT=50

# --- Tools -------------------------------------------------------------------

# The one directory the filesystem tools can see. Nothing outside it is
# reachable, and reaching for it is refused rather than approved.
# PROMETHEUS_WORKSPACE_DIR=~/Documents/prometheus

# What happens when an irreversible action comes up: prompt | deny | allow.
PROMETHEUS_APPROVAL_MODE=prompt

# --- Governance (Phase 10) ---------------------------------------------------

# How long an unanswered approval stays worth answering, before it is closed as
# EXPIRED. A question nobody comes back to leaves a PENDING row, and a PENDING
# row is a task `prometheus resume` keeps picking up. Zero waits forever, which is
# what a terminal prompt wants - somebody is standing there. It does not apply
# to the terminal for that reason; it applies to the page and to Telegram.
PROMETHEUS_APPROVAL_TTL_SECONDS=900

# Ask somebody who is not at the keyboard. Set both and any action needing
# approval arrives as a message with two buttons instead of a prompt nobody is
# looking at. Unset - which is the default - and nothing here reaches Telegram.
# Get the token from @BotFather; the chat id is the conversation to ask in.
# PROMETHEUS_SECRET_TELEGRAM_BOT_TOKEN=
# PROMETHEUS_SECRET_TELEGRAM_CHAT_ID=

# Predefined processes under `workflows/`. On by default: with nothing declared
# there, it costs nothing.
# PROMETHEUS_FLAGS__WORKFLOWS=false

# Where workflow declarations are read from. Unset means the ones that ship.
# PROMETHEUS_WORKFLOWS_DIR=~/Documents/prometheus-workflows

# --- Memory (Phase 9) --------------------------------------------------------

# On by default. Off, employees start every task knowing only what they were
# told, which is how the platform behaved before it had a memory.
# PROMETHEUS_FLAGS__MEMORY=false

# How many recollections a run is given. Context is the scarcest thing in a run,
# and the seventh-best memory costs the same tokens as the best one.
PROMETHEUS_MEMORY_RECALL_LIMIT=6

# How many past outcomes accumulate before the oldest are folded into one
# summary. Below this, ranking filters better than a summary would.
PROMETHEUS_MEMORY_CONSOLIDATION_THRESHOLD=12

# --- Computer use (Phase 5) --------------------------------------------------

# On by default, and this flag governs the *desktop* surface only: driving the
# page the browser already has open comes with the browser tools. With it off,
# every scenario that has an API or a browser path keeps working - they are
# different rungs of the same ladder. On does not mean reachable: nothing on
# the desktop is touched until an application is allowed below.
# PROMETHEUS_FLAGS__COMPUTER_USE=false

# Which applications the desktop surface may act in. Empty means none: acting on
# the machine is opt-in per application, the way files are opt-in per directory.
# PROMETHEUS_COMPUTER_ALLOWED_APPLICATIONS=["Preview","Calculator"]

# The part of the screen that may be touched, as WIDTHxHEIGHT+X+Y. A click
# outside it is refused, so a misread coordinate cannot reach the menu bar.
# PROMETHEUS_COMPUTER_ALLOWED_REGION=1440x820+0+80

# A budget for actions on a screen, separate from the run's step limit: one step
# of the loop can ask for several clicks.
PROMETHEUS_COMPUTER_MAX_ACTIONS=200

# The brake is a file, not a setting: `prometheus stop` writes $PROMETHEUS_DATA_DIR/STOP and
# every action on a screen reads it first. `prometheus stop --clear` releases it.

# --- Plugins -------------------------------------------------------------------

# Credentials this installation supplies to plugins, so a person installing one
# does not have to. The Google OAuth client below is what makes Gmail and Google
# Drive a "Sign in with Google" button instead of a Cloud Console. Create it once
# (Desktop app client, consent screen published "In production"); keep the values
# here and never in the repository.
# PROMETHEUS_PLUGIN_CREDENTIALS__GOOGLE_OAUTH_CLIENT_ID=1234-abcd.apps.googleusercontent.com
# PROMETHEUS_PLUGIN_CREDENTIALS__GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-...
